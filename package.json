{
  "name": "medicina-democratica-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:render": "node --import tsx --test --test-isolation=none tests/render.integration.ts",
    "test:production": "node --import tsx --test --test-isolation=none tests/production.integration.ts",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "demo": "node --import tsx src/pipeline/cli.ts demo",
    "render": "node --import tsx src/pipeline/cli.ts render",
    "produce": "node --import tsx src/pipeline/cli.ts produce",
    "validate": "node --import tsx src/pipeline/cli.ts validate",
    "align": "node --import tsx src/pipeline/cli.ts align",
    "studio": "remotion studio src/video/index.ts",
    "api": "node --import tsx src/api/server.ts",
    "tts": "node --import tsx src/pipeline/tts-cli.ts"
  },
  "dependencies": {
    "@fastify/multipart": "9.3.0",
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "fastify": "5.12.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.541",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
